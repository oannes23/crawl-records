# Copy to .env and edit. All vars are EMBASSY_-prefixed.

# Storage. Swap to Postgres by changing this single line, e.g.:
#   EMBASSY_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/embassy
EMBASSY_DATABASE_URL=sqlite:///./embassy.db

# Admin panel (HTTP Basic) — CHANGE THESE in any real deployment.
EMBASSY_ADMIN_USER=admin
EMBASSY_ADMIN_PASSWORD=changeme

# Advertised versions (opaque tokens; set to the game's real ruleset/content versions).
EMBASSY_RULESET_VERSION=0.0.0-dev
EMBASSY_CONTENT_VERSION=0.0.0-dev
EMBASSY_CONSENT_VERSION=1

# Ingest controls.
EMBASSY_ENABLE_INGEST=true
EMBASSY_MAX_BATCH=100
