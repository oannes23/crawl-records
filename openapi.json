      "DailySpec": {
        "description": "An OPTIONAL authored-daily channel (SERVICE-REPLY.md item 1, path b).\n\nWhen present, the client uses these selections instead of deriving them from ``seed``;\nevery id is validated against the client's LOCAL registry (an unknown id \u21d2 the daily is\nunavailable, handled exactly like a version mismatch \u2014 never a content download). When\n``spec`` is absent the client derives all selections from ``seed`` alone (path a, the MVP\ndefault). The field exists now so authored dailies are not a future schema break.\n``params`` is an open object for per-daily knobs (modifiers, mutators) the client reads.",
        "properties": {
          "classId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Classid"
          },
          "dungeonId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dungeonid"
          },
          "foeId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Foeid"
          },
          "params": {
            "additionalProperties": true,
            "title": "Params",
            "type": "object"
          }
        },
        "title": "DailySpec",
        "type": "object"
      },
