      "RejectedRecord": {
        "description": "A per-record ingest rejection. ``terminal`` tells the client whether to quarantine/\ndrop the record (true) or keep it in the outbox and retry (false). Every reason the MVP\nemits \u2014 ``modded``, ``missing-version``, ``fingerprint-mismatch`` \u2014 is terminal. Any\nfuture retryable reject will carry ``terminal: false`` so the client branches on the\nboolean, never on parsing the reason string.",
        "properties": {
          "eventId": {
            "title": "Eventid",
            "type": "string"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "terminal": {
            "default": true,
            "title": "Terminal",
            "type": "boolean"
          }
        },
        "required": [
          "eventId",
          "reason"
        ],
        "title": "RejectedRecord",
        "type": "object"
      },
