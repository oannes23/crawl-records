  "info": {
    "summary": "The online backend for SET.crawl \u2014 run ingest, daily challenge, personal bests.",
    "title": "set-embassy",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/daily": {
      "get": {
        "operationId": "daily_daily_get",
        "parameters": [
          {
            "description": "YYYY-MM-DD; defaults to today (UTC)",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "default": "",
              "description": "YYYY-MM-DD; defaults to today (UTC)",
              "title": "Date",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DailyDescriptor"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Daily",
        "tags": [
          "embassy"
        ]
      }
    },
    "/handle/available": {
      "get": {
        "operationId": "handle_available_handle_available_get",
        "parameters": [
          {
            "in": "query",
            "name": "name",
            "required": true,
            "schema": {
              "maxLength": 64,
              "minLength": 1,
              "title": "Name",
              "type": "string"
            }
